{
  "name": "sudoku",
  // Built by `opennextjs-cloudflare build` from the Next.js app
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The site only lives on its own domain; PR previews get their own URLs
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "sudoku.eythorkonrads.com", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    // The adapter calls back into this Worker for some requests
    { "binding": "WORKER_SELF_REFERENCE", "service": "sudoku" },
  ],
}
